# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
*.o
*.a
*.out
*.exe # For any host-side utilities compiled on Windows

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
flasher_args.json # Generated in build directory
sdkconfig.old
sdkconfig

# ── Credentials ──────────────────────────────────────────────────────
# The device config holds a LIVE API key and the WiFi password. Ship the
# template (sdcard/config.example.json), never the filled-in file.
sdcard/config.json

# ── Agent runtime state written to the SD card ───────────────────────
# Task logs and session trajectories record the TARGET machine's screen
# contents, window titles, file names and typed text. Never publish those.
sdcard/log/
sdcard/plans/
sdcard/sessions/

# ── Vendored reference material ──────────────────────────────────────
# `ref/` held the standalone bring-up projects for this board and capture card
# (plus a Python venv dump: ~790 MB across ~51k files). It was archived out of
# the tree. The pattern stays as a guard so a stray copy cannot be committed.
ref/

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio

# ── Editor state ─────────────────────────────────────────────────────
# The ESP-IDF extension rewrites these with ABSOLUTE machine paths (the IDF
# install, the clangd binary, the serial port, and a --compile-commands-dir
# pointing into this checkout). Committing them both leaks the author's local
# directory layout and leaves them broken for anyone who clones the repository.
.vscode/


# ── The frozen Python prototype ──────────────────────────────────────
# Bytecode, virtualenvs, and RUNTIME STATE. The prototype wrote task plans,
# machine profiles and logs while it ran; those describe the target machine,
# so they must never be published.
prototype/**/__pycache__/
prototype/**/*.pyc
prototype/**/.venv/
prototype/**/log/
prototype/**/plans/*.json
prototype/**/profiles/*.md
